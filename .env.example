# ==============================================================================
# PathSyncCare-AI Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit the actual .env file or credentials to source control!
# ==============================================================================

# Azure SQL Database Configuration (Confirmed Azure SQL Provisioning)
AZURE_SQL_SERVER=pathsynccare-sql-2026.database.windows.net
AZURE_SQL_DATABASE=pathsynccare_db
AZURE_SQL_USERNAME=your_sql_admin_username
AZURE_SQL_PASSWORD=your_sql_admin_password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_CERT=no
AZURE_SQL_TIMEOUT=30

# Optional: Direct database URL override (e.g. for testing with sqlite)
# DATABASE_URL=

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
