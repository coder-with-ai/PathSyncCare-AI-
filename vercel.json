{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "routes": [
                { "src": "/(.*)", "dest": "/index.html" }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "app.main:app"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
