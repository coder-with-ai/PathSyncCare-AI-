# Azure SQL Database Configuration (Confirmed Azure SQL Provisioning)
AZURE_SQL_SERVER=pathsynccare-sql-2026.database.windows.net
AZURE_SQL_DATABASE=pathsynccare_db
AZURE_SQL_USERNAME=your_sql_admin_username
AZURE_SQL_PASSWORD=your_sql_admin_password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_CERT=no
AZURE_SQL_TIMEOUT=30

# Optional: Direct database URL override
# DATABASE_URL=

ENVIRONMENT=development
LOG_LEVEL=INFO
